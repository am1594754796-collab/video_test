# =============================================================================
# 统一 API 配置（复制为 api.env 后填入 Key）
# 路径：python/data/api.env   ← 唯一推荐配置文件，已 gitignore，勿提交
# 启动 uvicorn 时自动加载。旧文件 online.env 仍兼容，但请逐步迁到本文件。
# =============================================================================

# —— 共用（语音语义 + 千问人脸）——
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文本对话（抢答语义判分）
LLM_CHAT_MODEL=qwen-plus
# 多模态视觉（人脸检测 / 绑座）— 必须用 vl 模型
LLM_VISION_MODEL=qwen-vl-plus

# —— 功能开关 ——
SPEECH_SEMANTIC_MODE=online
VISION_FACE_MODE=qwen

# —— 兼容旧变量名（可留空；优先读上面的 LLM_*）——
# SPEECH_LLM_API_KEY=
# SPEECH_LLM_BASE_URL=
# SPEECH_LLM_MODEL=
# VISION_LLM_API_KEY=
# VISION_LLM_BASE_URL=
# VISION_LLM_MODEL=
