# 线上语义判分（整句解释）— 复制为 online.env 后填入 Key
# 启动 API 时会自动加载 python/data/online.env（勿把含 Key 的 online.env 提交到 Git）
#
# DeepSeek（当前 V2.0 推荐）：
#   SPEECH_SEMANTIC_MODE=online
#   SPEECH_LLM_API_KEY=sk-...
#   SPEECH_LLM_BASE_URL=https://api.deepseek.com
#   SPEECH_LLM_MODEL=deepseek-chat
#
# 通义示例：
#   SPEECH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   SPEECH_LLM_MODEL=qwen-turbo
#
# OpenAI 示例：
#   SPEECH_LLM_BASE_URL=https://api.openai.com/v1
#   SPEECH_LLM_MODEL=gpt-4o-mini

SPEECH_SEMANTIC_MODE=online
SPEECH_LLM_API_KEY=
SPEECH_LLM_BASE_URL=https://api.deepseek.com
SPEECH_LLM_MODEL=deepseek-chat
