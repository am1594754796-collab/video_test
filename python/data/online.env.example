# 旧配置文件（兼容）。推荐改用 **api.env**（统一 Key）。
# 复制 api.env.example → api.env 填写 LLM_API_KEY 即可。
#
# 若仍使用本文件，变量名 SPEECH_LLM_* / VISION_LLM_* 仍可用。

SPEECH_SEMANTIC_MODE=online
SPEECH_LLM_API_KEY=
SPEECH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SPEECH_LLM_MODEL=qwen-plus

VISION_FACE_MODE=qwen
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_MODEL=qwen-vl-plus
