# =============================================================================
# 换机只需填这一项。地址 / 模型 / 开关已内置，不要改。
# 复制：copy deploy\api.env.example python\data\api.env
# 真实密钥文件已 gitignore，勿提交。
# =============================================================================

# 阿里云 DashScope API Key（CosyVoice 读题）
LLM_API_KEY=

# 读题默认 cosyvoice-v2 / longxiaochun_v2，一般不用改。
# 复刻音色：把 TTS_VOICE 换成百炼控制台里的音色 ID（须与 TTS_MODEL 匹配）。
# 若 dashscope.aliyuncs.com 不可用，填写业务空间 ID 走新域名。
# TTS_MODEL=cosyvoice-v2
# TTS_VOICE=longxiaochun_v2
# TTS_WORKSPACE_ID=
